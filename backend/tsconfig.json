{
  "compilerOptions": {
    "module": "nodenext",
    /* Restricts ambient global type inclusion to node + jest only. Verified safe as of
       this comment — every other @types package in this project (express, helmet, pg,
       supertest) is consumed via explicit `import type` statements, not ambient globals. */
    "types": ["node", "jest"],
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true
  }
}
